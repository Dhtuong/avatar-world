[sub_resource type="GDScript" id="GDScript_hc608"]
script/source = "
extends Area2D

# ==========================================
# AVATAR WORLD - FARM GATE
# ==========================================

# Scene nông trại bên trong
@export_file(\"*.tscn\") var target_scene: String = \"res://scenes/world/personal_farm.tscn\"

# Ngăn chuyển scene nhiều lần
var changing_scene: bool = false


func _ready() -> void:
	body_entered.connect(_on_body_entered)


func _on_body_entered(body: Node2D) -> void:
	if changing_scene:
		return

	if body.name != \"Player\":
		return

	changing_scene = true

	print(\"FARM: Player đã đi qua cổng FARM\")
	print(\"FARM: Đang vào nông trại bên trong...\")

	# Chờ physics xử lý xong rồi mới chuyển scene
	get_tree().call_deferred(
		\"change_scene_to_file\",
		target_scene
	)
"

